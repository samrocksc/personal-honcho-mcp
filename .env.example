# personal-honcho-mcp configuration
# Copy to .env (or set in docker-compose) and adjust.

# ── Honcho connection ──────────────────────────────────────────────
# Your self-hosted Honcho server
HONCHO_API_URL=http://localhost:8000
# API key. Leave empty for keyless self-hosted mode.
HONCHO_API_KEY=
# Default workspace. Omitted → every tool call must pass workspace_id.
HONCHO_WORKSPACE_ID=default

# ── Identity layer ─────────────────────────────────────────────────
# You — powers all "my" tools (get_my_peer_card, chat_about_me, ...)
HONCHO_USER_PEER_ID=
# Default AI peer. Override per tool call to use others.
HONCHO_AI_PEER_ID=
# Default reasoning level for chat-family tools: minimal|low|medium|high|max
#HONCHO_REASONING_LEVEL=medium

# ── Tuning ─────────────────────────────────────────────────────────
# Per-request Honcho API timeout (ms). Chat can be slow; keep generous.
HONCHO_TIMEOUT_MS=300000

# ── HTTP host (Docker / mcp-remote) ────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Idle MCP sessions are dropped after this many ms
MCP_SESSION_IDLE_MS=1800000
# Max concurrent MCP sessions
MCP_SESSION_MAX=128