{
  "name": "personal-honcho-mcp",
  "version": "1.0.0",
  "description": "Personal Honcho MCP server for self-hosted Honcho, with an identity layer for a configured user and AI peer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "test": "npm run typecheck && node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "effect": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
